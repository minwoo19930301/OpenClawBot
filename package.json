{
  "name": "custom-cloud-bot",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "Build your own cloud agent: choose your server, models, tools and private credentials.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -ws --if-present",
    "test": "npm run test -ws --if-present",
    "typecheck": "tsc -b --pretty false",
    "demo": "npm run demo -w @open-grokbot/demo"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0"
  }
}

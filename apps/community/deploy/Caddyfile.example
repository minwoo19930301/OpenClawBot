# For the standalone systemd service, provide COMMUNITY_PUBLIC_HOST to Caddy.
{$COMMUNITY_PUBLIC_HOST} {
    encode zstd gzip
    request_body {
        max_size 13MB
    }
    reverse_proxy 127.0.0.1:8787
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }
}

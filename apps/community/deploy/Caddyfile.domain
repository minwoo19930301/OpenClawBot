{
    admin off
    default_sni {$COMMUNITY_PUBLIC_HOST}
    servers {
        protocols h1 h2
    }
}
https://{$COMMUNITY_PUBLIC_HOST} {
    encode zstd gzip
    request_body {
        max_size 13MB
    }
    reverse_proxy app:8787
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }
}

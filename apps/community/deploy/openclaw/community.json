{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18890,
    "auth": { "mode": "token", "token": "${COMMUNITY_OPENCLAW_TOKEN}" },
    "controlUi": { "enabled": false },
    "http": {
      "endpoints": {
        "responses": {
          "enabled": true,
          "files": { "allowUrl": false },
          "images": { "allowUrl": false }
        }
      }
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace",
      "model": { "primary": "communityGroq/openai/gpt-oss-120b" },
      "maxConcurrent": 1,
      "heartbeat": { "every": "0m" },
      "skipBootstrap": true
    },
    "entries": { "community": {} }
  },
  "models": {
    "mode": "replace",
    "providers": {
      "communityGroq": {
        "baseUrl": "https://api.groq.com/openai/v1",
        "apiKey": "${GROQ_API_KEY}",
        "api": "openai-completions",
        "models": [{
          "id": "openai/gpt-oss-120b",
          "name": "GPT OSS 120B",
          "reasoning": true,
          "input": ["text"],
          "contextWindow": 131072,
          "maxTokens": 1024
        }]
      }
    }
  },
  "tools": { "deny": ["*"] },
  "plugins": { "enabled": false },
  "browser": { "enabled": false },
  "cron": { "enabled": false },
  "hooks": { "enabled": false }
}

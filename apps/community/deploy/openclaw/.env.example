# Optional: copy to deploy/.env.openclaw (0600) only when enabling the gateway.
# The token must match COMMUNITY_OPENCLAW_TOKEN in deploy/.env.production.
COMMUNITY_OPENCLAW_TOKEN=
# Explicitly choose your provider endpoint, adapter, model and credential.
# OPENCLAW_MODEL_API can be openai-completions, openai-responses, etc.
OPENCLAW_MODEL_BASE_URL=
OPENCLAW_MODEL_API=
OPENCLAW_MODEL_API_KEY=
OPENCLAW_MODEL_ID=
OPENCLAW_MODEL_NAME=

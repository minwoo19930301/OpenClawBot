{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18890,
    "auth": {
      "mode": "token",
      "token": "${COMMUNITY_OPENCLAW_TOKEN}"
    },
    "controlUi": {
      "enabled": false
    },
    "http": {
      "endpoints": {
        "responses": {
          "enabled": true,
          "files": {
            "allowUrl": false
          },
          "images": {
            "allowUrl": false
          }
        }
      }
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace",
      "maxConcurrent": 1,
      "heartbeat": {
        "every": "0m"
      },
      "skipBootstrap": true
    },
    "entries": {
      "community": {}
    }
  },
  "tools": {
    "deny": [
      "*"
    ]
  },
  "plugins": {
    "enabled": true,
    "allow": [
      "openai"
    ],
    "entries": {
      "openai": {
        "enabled": true
      }
    }
  },
  "browser": {
    "enabled": false
  },
  "cron": {
    "enabled": false
  },
  "hooks": {
    "enabled": false
  },
  "models": {
    "mode": "merge",
    "providers": {
      "openai": {
        "agentRuntime": {
          "id": "openclaw"
        }
      }
    }
  }
}

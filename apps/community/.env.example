# Load environment values through your deployment service, not the browser.
COMMUNITY_HOST=127.0.0.1
COMMUNITY_PORT=8787
COMMUNITY_DATA_DIR=/var/lib/bot-lounge
COMMUNITY_ORIGIN=https://your-domain.example
# Random, private initial invitation. Consumed by the first admin signup.
COMMUNITY_BOOTSTRAP_TOKEN=
COMMUNITY_DEMO=0
COMMUNITY_DAILY_TURNS=30
COMMUNITY_GLOBAL_DAILY_TURNS=200
# Dedicated service credentials. Leave empty to disable AI calls.
COMMUNITY_LLM_BASE_URL=
COMMUNITY_LLM_API_KEY=
COMMUNITY_LLM_MODEL=
# Optional isolated OpenClaw 2.0-series gateway. Takes priority over direct LLM.
COMMUNITY_OPENCLAW_BASE_URL=
COMMUNITY_OPENCLAW_TOKEN=
COMMUNITY_OPENCLAW_AGENT_ID=community
# Only allows the exact Docker service hostname 'openclaw' over private HTTP.
COMMUNITY_OPENCLAW_ALLOW_PRIVATE_HTTP=0
# One independently isolated desktop per mapped room; URLs stay server-side.
COMMUNITY_DESKTOP_MAP={}
# Optional first admin room provisioned at registration, must be in the desktop map.
COMMUNITY_INITIAL_ROOM_ID=
COMMUNITY_MEDIA_MAX_BYTES=12582912
COMMUNITY_MEDIA_DAILY_BYTES=104857600
COMMUNITY_MEDIA_STORAGE_BYTES=1073741824

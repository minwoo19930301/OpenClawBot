# Copy to .env.portable and chmod 600. This app-only stack binds host loopback.
COMMUNITY_ORIGIN=http://127.0.0.1:8787
# Required: generate a private invitation, e.g. openssl rand -hex 32.
COMMUNITY_BOOTSTRAP_TOKEN=
COMMUNITY_DEMO=0
# Optional: select a different env file for both interpolation and container env.
# Invoke Compose with --env-file <same path> when changing this value.
COMMUNITY_ENV_FILE=.env.portable
# Leave AI blank and connect it later through the administrator setup screen.
COMMUNITY_LLM_BASE_URL=
COMMUNITY_LLM_API_KEY=
COMMUNITY_LLM_MODEL=
GROQ_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_TOKEN=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
COHERE_API_KEY=
NVIDIA_NIM_API_KEY=
COMMUNITY_LLM_PROVIDERS=
COMMUNITY_OPENCLAW_BASE_URL=
COMMUNITY_OPENCLAW_TOKEN=
COMMUNITY_INTEGRATIONS_FILE=
COMMUNITY_AGENT_CONTEXT_FILE=

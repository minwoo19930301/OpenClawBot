{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18890,
    "auth": {
      "mode": "token",
      "token": "${COMMUNITY_OPENCLAW_TOKEN}"
    },
    "controlUi": {
      "enabled": false
    },
    "http": {
      "endpoints": {
        "responses": {
          "enabled": true,
          "files": {
            "allowUrl": false
          },
          "images": {
            "allowUrl": false
          }
        }
      }
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace",
      "model": {
        "primary": "configured/${OPENCLAW_MODEL_ID}"
      },
      "maxConcurrent": 1,
      "heartbeat": {
        "every": "0m"
      },
      "skipBootstrap": true
    },
    "entries": {
      "community": {}
    }
  },
  "models": {
    "mode": "replace",
    "providers": {
      "configured": {
        "baseUrl": "${OPENCLAW_MODEL_BASE_URL}",
        "apiKey": "${OPENCLAW_MODEL_API_KEY}",
        "api": "${OPENCLAW_MODEL_API}",
        "models": [
          {
            "id": "${OPENCLAW_MODEL_ID}",
            "name": "${OPENCLAW_MODEL_NAME}",
            "input": [
              "text"
            ]
          }
        ]
      }
    }
  },
  "tools": {
    "deny": [
      "*"
    ]
  },
  "plugins": {
    "enabled": false
  },
  "browser": {
    "enabled": false
  },
  "cron": {
    "enabled": false
  },
  "hooks": {
    "enabled": false
  }
}
